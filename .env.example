# ──────────────────────────────────────────────────────────────
# Base de données
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_marketing"

# ──────────────────────────────────────────────────────────────
# Serveur
# ──────────────────────────────────────────────────────────────
PORT=3000

# Mode démo : quand true, toutes les API externes sont simulées
# (contenus, images, publications, publicités, emails, WhatsApp, Messenger).
# Passez à false une fois les clés API renseignées.
DEMO_MODE=true

# Clé d'accès à l'API d'administration (/api).
# Vide = API ouverte (démo uniquement). Définissez-la en production.
ADMIN_API_KEY=

# ──────────────────────────────────────────────────────────────
# Identité de l'hôtel (utilisée dans tous les contenus générés)
# ──────────────────────────────────────────────────────────────
HOTEL_NAME="Conrad Grand Luxury Hotel"
HOTEL_TAGLINE="Le luxe à l'état pur"
# Site officiel de l'hôtel : l'agent y collecte automatiquement
# les vraies images de la médiathèque quand celle-ci est vide.
HOTEL_WEBSITE=""
CONTENT_LANGUAGE=fr

# ──────────────────────────────────────────────────────────────
# IA — LLM (textes, scripts, copies)
# LLM_PROVIDER : auto | openai | anthropic | gemini | ollama |
#                groq | mistral | openrouter | deepseek | together
# « auto » choisit le premier fournisseur configuré ci-dessous.
# ──────────────────────────────────────────────────────────────
LLM_PROVIDER=auto
# Laissez vide pour utiliser le modèle par défaut de chaque fournisseur
# (gpt-4o-mini, claude-sonnet, gemini-2.0-flash, llama3.1, llama-3.3-70b…)
LLM_MODEL=
# Endpoint OpenAI-compatible générique (LM Studio, vLLM, Ollama HTTP…) :
LLM_BASE_URL=
LLM_API_KEY=

# Fournisseurs : renseignez ceux que vous utilisez.
#  - OpenAI      : platform.openai.com
#  - Anthropic   : console.anthropic.com        (Claude)
#  - Google      : aistudio.google.com          (Gemini)
#  - Groq        : console.groq.com             (Llama 3.3, gratuit et rapide)
#  - Mistral     : console.mistral.ai
#  - OpenRouter  : openrouter.ai                (accès à des centaines de modèles)
#  - DeepSeek    : platform.deepseek.com
#  - Together    : api.together.ai              (Llama, Qwen, DeepSeek…)
#  - Ollama      : local, aucun compte requis   (ollama pull llama3.1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ──────────────────────────────────────────────────────────────
# IA — Images (dernière génération open source)
# IMAGE_PROVIDER : auto | openai | stability | replicate | fal |
#                  huggingface | together | getimg | local
# ──────────────────────────────────────────────────────────────
IMAGE_PROVIDER=auto
IMAGE_MODEL=dall-e-3

# Stability AI (SDXL)
STABILITY_API_KEY=
STABILITY_ENGINE=stable-diffusion-xl-1024-v1-0

# Replicate (Flux, SDXL, …)          : replicate.com
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# fal.ai (Flux, …)                   : fal.ai
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# Hugging Face Inference (Flux, SD)  : huggingface.co
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Together AI (Flux schnell free)    : api.together.ai
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# getimg.ai (SDXL)                   : getimg.ai
GETIMG_API_KEY=
GETIMG_MODEL=stable-diffusion-xl

# Générateur local AUTOMATIC1111 / ComfyUI (endpoint txt2img)
LOCAL_IMAGE_ENDPOINT=

# ──────────────────────────────────────────────────────────────
# IA — Vidéo
# VIDEO_PROVIDER : ffmpeg (diaporama Ken Burns + sous-titres, local)
#                | replicate | fal (text-to-video open source :
#                  Wan 2.2, HunyuanVideo, Mochi…)
#                | ai (tente l'IA puis se replie sur ffmpeg)
# ──────────────────────────────────────────────────────────────
VIDEO_PROVIDER=ffmpeg
REPLICATE_VIDEO_MODEL=wan-video/wan-2.2-5b
FAL_VIDEO_MODEL=fal-ai/wan/v2.2/5b/text-to-video

# Voix off (OpenAI TTS)
TTS_VOICE=alloy

# ──────────────────────────────────────────────────────────────
# Relecture IA des brouillons avant publication
# Seuil minimal du score (0-100) pour autoriser la publication.
# ──────────────────────────────────────────────────────────────
REVIEW_MIN_SCORE=40

# ──────────────────────────────────────────────────────────────
# Facebook / Meta
# ──────────────────────────────────────────────────────────────
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ──────────────────────────────────────────────────────────────
# Webhooks Meta (WhatsApp Cloud API + Messenger)
# ──────────────────────────────────────────────────────────────
WEBHOOK_VERIFY_TOKEN=

# ──────────────────────────────────────────────────────────────
# WhatsApp Business (Meta Cloud API)
# Créez les templates dans le Meta Business Manager :
#   hotel_welcome / hotel_followup / hotel_offer ({{1}} prénom, {{2}} hôtel, {{3}} offre)
# ──────────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_WELCOME=hotel_welcome
WHATSAPP_TEMPLATE_FOLLOWUP=hotel_followup
WHATSAPP_TEMPLATE_OFFER=hotel_offer

# ──────────────────────────────────────────────────────────────
# Messenger (Send API)
# ──────────────────────────────────────────────────────────────
MESSENGER_VERIFY_TOKEN=

# ──────────────────────────────────────────────────────────────
# Nurturing multicanal des leads
# ──────────────────────────────────────────────────────────────
NURTURE_CHANNELS=email,whatsapp,messenger
NURTURE_INTERVAL_HOURS=24

# ──────────────────────────────────────────────────────────────
# TikTok
# ──────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_IDENTITY_ID=

# ──────────────────────────────────────────────────────────────
# Emails (SMTP — relances et séquences)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="reservation@votre-hotel.com"
